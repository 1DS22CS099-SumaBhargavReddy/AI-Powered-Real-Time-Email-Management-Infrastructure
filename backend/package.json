{
  "name": "ai-email-management-backend",
  "version": "2.0.0",
  "description": "AI-Powered Real-Time Email Management Infrastructure - Backend Service",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "worker": "ts-node src/workers/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate:classification": "tsx ../evaluation/classification/evaluateClassification.ts",
    "evaluate:rag": "tsx ../evaluation/rag/evaluateRag.ts",
    "evaluate:productivity": "tsx ../evaluation/scripts/productivityBenchmark.ts",
    "benchmark:api": "tsx ../benchmarks/api/api.benchmark.ts",
    "benchmark:search": "tsx ../benchmarks/search/search.benchmark.ts",
    "benchmark:imap": "tsx ../benchmarks/imap/imap.benchmark.ts",
    "benchmark:ai": "tsx ../benchmarks/ai/ai.benchmark.ts",
    "benchmark:rag": "tsx ../benchmarks/rag/rag.benchmark.ts",
    "benchmark:load": "tsx ../benchmarks/load/load.benchmark.ts"
  },
  "keywords": [
    "email",
    "imap",
    "backend",
    "ai",
    "rag",
    "qdrant",
    "elasticsearch"
  ],
  "author": "Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@elastic/elasticsearch": "^9.1.1",
    "@google/genai": "^1.25.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "imapflow": "^1.3.6",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.5",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
